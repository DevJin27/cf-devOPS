{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cursor-devops-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cursor_devops",
      "database_id": "b59c9088-7221-4dfd-a3dd-d68ff01831aa",
      "migrations_dir": "../../infrastructure/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "cursor-devops"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "cursor-devops-ingestion",
      "binding": "INGESTION_WORKFLOW",
      "class_name": "IngestionWorkflow"
    }
  ]
}
