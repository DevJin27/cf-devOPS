      "@cursor-devops/retrieval": ["packages/retrieval/src/index.ts"],
      "@cursor-devops/answer-engine": ["packages/answer-engine/src/index.ts"],
      "@cursor-devops/github-ingestion": ["packages/github-ingestion/src/index.ts"],
      "@cursor-devops/embeddings": ["packages/embeddings/src/index.ts"],
      "@cursor-devops/workflow-runner": ["apps/workflow-runner/src/index.ts"]
